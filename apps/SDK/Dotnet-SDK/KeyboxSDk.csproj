<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>KeyboxSdk</PackageId>
		<Version>1.0.3</Version>
		<Authors>KeyBox</Authors>
		<Company>KeyBox</Company>
		<Description>KeyBox license protection SDK for .NET apps. Enterprise-grade license validation made simple.</Description>
		<PackageProjectUrl>https://keybox.dev</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>licensing;license-key;protection;security;keybox</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Exclude smoke tests from the NuGet package -->
	<ItemGroup>
		<None Remove="__smoke__\**" />
		<Content Remove="__smoke__\**" />
		<Compile Remove="__smoke__\**" />
		<EmbeddedResource Remove="__smoke__\**" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>
